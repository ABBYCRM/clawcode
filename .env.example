# Bitdeer AI Cloud — https://www.bitdeer.ai/
# Base URL: https://api-inference.bitdeer.ai/v1 (OpenAI-compatible)
# Get a key: account dashboard → API keys
BITDEER_API_KEY=
BITDEER_BASE_URL=https://api-inference.bitdeer.ai/v1
BITDEER_DEFAULT_MODEL=meta/llama-3.1-70b-instruct

# NVIDIA NIM — https://build.nvidia.com/
# Base URL: https://integrate.api.nvidia.com/v1 (OpenAI-compatible, 136+ models)
# Free tier: 1,000 credits on signup, 40 RPM per key
# You can add up to 12 keys for round-robin (12 x 40 = 480 RPM)
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_KEY_1=
NVIDIA_NIM_KEY_2=
NVIDIA_NIM_KEY_3=
NVIDIA_NIM_KEY_4=
NVIDIA_NIM_KEY_5=
NVIDIA_NIM_KEY_6=
NVIDIA_NIM_KEY_7=
NVIDIA_NIM_KEY_8=
NVIDIA_NIM_KEY_9=
NVIDIA_NIM_KEY_10=
NVIDIA_NIM_KEY_11=
NVIDIA_NIM_KEY_12=
NVIDIA_NIM_DEFAULT_MODEL=meta/llama-3.1-405b-instruct

# Claw-code uses these env vars at runtime. Map your preferred provider into them.
# Default: route everything through NVIDIA NIM.
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=

# Default model (must match what the server exposes)
CLAW_MODEL=nvidia/meta/llama-3.1-405b-instruct

# Optional: switch providers on the fly
# CLAW_MODEL=bitdeer/meta/llama-3.1-70b-instruct
# CLAW_MODEL=nvidia/qwen/qwen3-coder-480b-a35b-instruct
# CLAW_MODEL=nvidia/moonshotai/kimi-k2-instruct

# Optional: Anthropic key if you also want direct Claude access
# ANTHROPIC_API_KEY=
